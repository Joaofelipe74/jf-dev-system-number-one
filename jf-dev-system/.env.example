# ============================================================
# JF DEV — Sistema de Gestão e Agendamento
# Arquivo de exemplo de variáveis de ambiente.
#
# Copie este arquivo para ".env" (não ".env.local") e preencha com valores
# reais. Por quê ".env" e não ".env.local"? Porque tanto o Next.js quanto o
# CLI do Prisma (`prisma migrate`, `prisma studio`) E os scripts standalone
# executados via `tsx` (`prisma/seed.ts`, `prisma/create-admin.ts`, que
# carregam "dotenv/config" explicitamente) leem ".env" automaticamente —
# ".env.local" só é lido pelo Next.js, o que causava o erro
# "P1012: DATABASE_URL não definida" ao rodar comandos do Prisma
# diretamente (relatado na auditoria).
#
# NUNCA coloque valores reais neste arquivo (.env.example é versionado).
# ============================================================

# --- Banco de dados (obrigatório) ---
# Connection string de um Postgres real. Para desenvolver localmente sem
# depender do Supabase, suba um Postgres com um único comando Docker (veja
# o README, seção "Instalação"):
#   docker run --name jfdev-postgres -e POSTGRES_PASSWORD=postgres -p 5432:5432 -d postgres:16
# e use:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jfdev?schema=public"
# Supabase session-mode pooler URL used by Prisma migrations. Keep this
# separate from DATABASE_URL when deploying to serverless environments.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/jfdev"
# Em produção, use a connection string do seu projeto Supabase (Project
# Settings → Database → Connection string → "URI", modo "Transaction" para
# ambientes serverless).

# --- Autenticação administrativa (obrigatório) ---
# Segredo usado para assinar os cookies de sessão administrativa (JWT) E os
# tokens de acesso de curta duração da Área do Cliente. Gere um valor
# aleatório forte, por exemplo com: openssl rand -base64 32
AUTH_SECRET=
# Duração da sessão administrativa, em segundos (padrão: 8 horas)
AUTH_SESSION_DURATION=28800

# --- Criação da conta de administrador (usado apenas por "npm run db:create-admin") ---
# Nunca fica hardcoded no código-fonte — o script lê estas variáveis (ou
# pergunta interativamente no terminal se elas não estiverem definidas).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME="Administrador"

# --- Seed de dados de demonstração (opcional) ---
# Só é necessário definir se você quiser FORÇAR o seed de demonstração a
# rodar contra um banco que já tem dados (ou em produção) — o script recusa
# rodar sem isso, para nunca apagar dados reais por engano. Veja
# "prisma/seed.ts".
# SEED_FORCE=eu-entendo-que-isso-apaga-dados

# --- Supabase (opcional, apenas se você usar os recursos nativos do Supabase) ---
# A ANON KEY é uma chave PÚBLICA, seguindo a própria documentação do
# Supabase, então pode ser exposta ao navegador (por isso o prefixo
# NEXT_PUBLIC_). A SERVICE ROLE KEY é PRIVADA e NUNCA deve ter o prefixo
# NEXT_PUBLIC_ nem ser usada em código que roda no navegador — apenas em
# scripts de servidor (o Prisma, aqui, já roda inteiramente no servidor,
# então nem chega a precisar dela para as operações normais do sistema).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Aplicação ---
# URL pública onde o site está publicado — usada para montar URLs
# absolutas de Open Graph/compartilhamento (metadados de SEO).
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
